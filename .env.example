# Copy to .env for local development. .env is ignored by git.

# The local stack's PostgreSQL (compose.yaml). The password is local-only and not a secret.
DATABASE_URL=postgres://off_book:off_book@127.0.0.1:5432/off_book?sslmode=disable

# Optional: publish the local PostgreSQL on another port if 5432 is taken. Change DATABASE_URL to match.
# OFF_BOOK_DB_PORT=5432
