{
  "name": "off-book",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "check-format": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check-licences": "node tools/licence-check/src/main.ts",
    "db:reset": "docker compose down --volumes && docker compose up --wait"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005"
  }
}
